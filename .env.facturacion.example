# Rutas locales — carpeta única de materiales FE (NO commitear .env real)
# Copia a backend/.env y completa DATABASE_URL (Supabase) + rutas DIAN

# Carpeta con PDFs, ZIP DIAN y repo de referencia
FACTURACION_REF_DIR=C:\path\to\facturacion

# Repo implementación habilitación (FastAPI DIAN)
DIAN_REFERENCE_APP=C:\path\to\facturacion\facturacion-electronica-colombia-main\facturacion-electronica-colombia-main

# URL del microservicio de referencia (si corre en 8001)
DIAN_SERVICE_URL=http://localhost:8001

# Supabase (Expertak)
# DATABASE_URL=postgresql://...
