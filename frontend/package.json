{
  "name": "excel-import-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "vite dev",
    "dev:backend": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir \"../backend\"",
    "dev:solo": "vite dev",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "concurrently": "^9.2.1",
    "svelte": "^4.2.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
